    "meta": {
      "id": "template_1832",
      "name": "Moving Services Promotion",
      "kind": "post",
      "aspect": "1:1",
      "tags": [
        "moving services",
        "business",
        "promotion"
      ],
      "description": "A square promotional template showcasing packing and moving services, including household and office relocation, vehicle transportation, and storage solutions.",
      "canvas_size": {
        "width": 675.0,
        "height": 675.0
      },
      "background_image_url": "https://assets.quickhub.ai/qh-templates-2/personaservices47.png",
      "background": {
        "kind": "background_photo",
        "generate": true,
        "transparent": false,
        "prompt": "Create a background with a soft, crumpled paper texture covering the entire canvas. In the top-left corner (0-20% across, 0-20% down), place a large solid circle (this template: dark blue) occupying about 15% of the canvas width. Add a subtle, semi-transparent circular overlay in the top-right quadrant (50-100% across, 0-50% down), blending softly with the background. Ensure the lighting is soft and diffused, creating a gentle and calm atmosphere. Leave the middle-right area (44-100% across, 9-90% down) empty for a foreground element. A separate round photo layer covers the middle-right of the frame (about 44–100% across, 9–90% down): draw no circle, ring, frame, shadow or photo there — keep plain background surface. No text, lettering, logos or watermarks anywhere in the image.",
        "reference_url": "https://assets.quickhub.ai/qh-templates-2/personaservices47.png",
        "notes": "Ensure high contrast between the background and the dark text area (8-49% across, 23-64% down) for readability. Keep the middle-right area clear for the round photo layer. Text fixed in dark (rgb(63, 55, 52)) sits in the area about 8–49% across, 23–64% down, so that part of the background must stay a light, calm tone that it reads clearly on — never dark or busy, even when a brief asks for a moody palette. The photo frames are separate layers; a regenerated background must not contain its own circles, rings or photos under them."
      },

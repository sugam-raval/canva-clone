    "meta": {
      "id": "template_3",
      "name": "Digital Agency Promo",
      "kind": "post",
      "aspect": "1:1",
      "tags": [
        "digital marketing",
        "business",
        "promotion"
      ],
      "description": "A promotional post template for digital marketing agencies to attract new clients.",
      "canvas_size": {
        "width": 1080.0,
        "height": 1080.0

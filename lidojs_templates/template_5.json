    "meta": {
      "id": "template_5",
      "name": "Restaurant Opening Announcement",
      "kind": "post",
      "aspect": "1:1",
      "tags": [
        "restaurant",
        "announcement",
        "opening"
      ],
      "description": "A social media post template for announcing the opening of a new restaurant.",
      "canvas_size": {
        "width": 1080.0,
        "height": 1080.0
      },
      "background_image_url": "https://assets.quickhub.ai/qh-social/user-image/1790678343_ac90fd8d-9e16-48d4-9e1d-a01cf847263f.png",
      "background": {
        "kind": "background_photo",
        "generate": true,
        "transparent": false,
        "prompt": "Create a background with a solid dark brown color. The canvas is 1080x1080 pixels. Leave a central square area (approximately 15–85% across and 15–85% down) empty for a separate photo layer. The background should be plain and consistent, with no additional elements or textures. Ensure the style is minimalistic and modern, suitable for overlaying text and images. A separate photo layer covers the center of the frame (about 15–85% across, 15–85% down): draw no circle, ring, frame, shadow or photo there — keep plain background surface, as if the canvas physically ended at that boundary; do not let the scene, gradient or lighting reach into it even faded. No text, lettering, logos or watermarks anywhere in the image.",
        "reference_url": "https://assets.quickhub.ai/qh-social/user-image/1790678343_ac90fd8d-9e16-48d4-9e1d-a01cf847263f.png",
        "notes": "Ensure the central area remains clear for the photo layer. Text fixed in white sits in the upper-center of the frame (about 22–78% across, 6–23% down); the lower-center of the frame (about 26–74% across, 89–93% down); the middle-left of the frame (about 0–29% across, 48–52% down); the middle-right of the frame (about 72–100% across, 48–52% down), so there the background must stay a saturated, medium-to-dark tone that it reads clearly on — never pastel, pale, cream or near-white, even when a brief asks for soft or light tones (put those elsewhere and in the accents instead). The photo frames are separate layers; a regenerated background must not contain its own circles, rings or photos under them."
      },

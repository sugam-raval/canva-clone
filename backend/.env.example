# Copy to backend/.env and fill in. Only OPENAI_API_KEY is required for real output;
# without it every model adapter falls back to a deterministic stub.

OPENAI_API_KEY=

# Infrastructure — matches infra/docker-compose.yml
DATABASE_URL=postgresql+asyncpg://design:design@localhost:5442/design

STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9010
S3_BUCKET=design-assets
S3_ACCESS_KEY=designminio
S3_SECRET_KEY=designminio
# Optional: public-facing host for generated asset URLs, when S3_ENDPOINT_URL's
# localhost link isn't reachable from wherever the URL is opened (e.g. an ngrok tunnel
# to S3_ENDPOINT_URL). Must include the bucket segment, e.g.:
# S3_PUBLIC_BASE_URL=https://<your-tunnel>.ngrok-free.app/design-assets

# Models
LLM_MODEL=gpt-6-astra
LLM_REASONING_EFFORT=low
LLM_MODEL_FAST=gpt-4o-mini
LIDO_ENRICH_VISION_MODEL=gpt-4o
# Local embedding model for template matching. lido_templates.embedding is vector(384),
# so a model with another dimension also needs that column altered.
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# Template catalog: db (lido_templates in Postgres, synced from lidojs_templates/*.json)
# or files (in memory, no database). Changed files are re-synced after this many seconds.
LIDO_TEMPLATE_STORE=db
LIDO_TEMPLATE_SYNC_SECONDS=10
IMAGE_MODEL=gpt-image-2.5-sunburst
# Lido.js (template) flow: uses LLM_REASONING_EFFORT/LLM_MODEL for its main fill call
# and LLM_MODEL_FAST for the (optional) repair call; this only sets image quality.
LIDO_TEMPLATE_IMAGE_QUALITY=high

# Adapter selection: openai | stub (see app/adapters/registry.py)
ADAPTER_TEXT_TO_IMAGE=auto
ADAPTER_TRANSPARENT_IMAGE=auto
ADAPTER_LLM=auto

# ======================================================================================
# backend/.env — copy .env.example to backend/.env and fill in.
# Only OPENAI_API_KEY is required for real output; without it every model adapter falls
# back to a deterministic stub.
#
#   1. SHARED              used by BOTH features below
#   2. FILL A TEMPLATE     match an existing template to a prompt and fill it
#                          (app/lido_corpus, the template catalog, /v1/lido/generate)
#   3. DESIGN FROM SCRATCH design a brand-new template from a prompt
#                          (app/lido_create, the "Design new template" tab, /v1/lido/drafts)
# ======================================================================================


# ======================================================================================
# 1. SHARED — used by both "fill a template" and "design from scratch"
# ======================================================================================

# -- OpenAI ----------------------------------------------------------------------------
OPENAI_API_KEY=

# -- Infrastructure (matches infra/docker-compose.yml) ---------------------------------
# Postgres: the template catalog (fill) and saved drafts (design from scratch).
DATABASE_URL=postgresql+asyncpg://design:design@localhost:5442/design

# Object storage for every generated image (filled templates' images, drafts' photos
# and previews).
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9010
S3_BUCKET=design-assets
S3_ACCESS_KEY=designminio
S3_SECRET_KEY=designminio
# Optional: public-facing host for generated asset URLs, when S3_ENDPOINT_URL's
# localhost link isn't reachable from wherever the URL is opened (e.g. an ngrok tunnel
# to S3_ENDPOINT_URL). Must include the bucket segment, e.g.
# https://<your-tunnel>.ngrok-free.app/design-assets
# S3_PUBLIC_BASE_URL=https://<your-tunnel>.ngrok-free.app/design-assets

# -- Adapter selection: auto | openai | stub (see app/adapters/registry.py) -------------
ADAPTER_TEXT_TO_IMAGE=auto
ADAPTER_TRANSPARENT_IMAGE=auto
ADAPTER_LLM=auto

# -- Default LLMs ----------------------------------------------------------------------
# FILL: LLM_MODEL (+ LLM_REASONING_EFFORT) makes the main fill call, LLM_MODEL_FAST the
#       repair call and template matching.
# DESIGN FROM SCRATCH: only used when its own LIDO_PLAN_* / LIDO_LAYOUT_* /
#       LIDO_REPAIR_* settings (section 3) are left empty.
# LLM_REASONING_EFFORT: none | minimal | low | medium | high; empty = LLM_MODEL without
# reasoning (set it together with LLM_MODEL when swapping reasoning/non-reasoning models).
LLM_MODEL=gpt-6-astra
LLM_REASONING_EFFORT=low
LLM_MODEL_FAST=gpt-4o-mini

# -- Images ----------------------------------------------------------------------------
# Every image both features generate: filled templates' backgrounds/subjects and
# designed templates' photos.
IMAGE_MODEL=gpt-image-2.5-sunburst
# Quality of EVERY generated image — despite the name, this also sets the quality of
# photos in templates designed from scratch: low | medium | high.
LIDO_TEMPLATE_IMAGE_QUALITY=high
# Seconds before a hung image request is abandoned and tried once more.
IMAGE_TIMEOUT_SECONDS=90


# ======================================================================================
# 2. FILL A TEMPLATE — match an existing template to a prompt and fill it
#    (app/lido_corpus; uses LLM_MODEL / LLM_MODEL_FAST and the images settings above)
# ======================================================================================

# Template catalog: db (lido_templates in Postgres, synced from lidojs_templates/*.json)
# or files (in memory, no database). Changed files are re-synced after this many seconds.
LIDO_TEMPLATE_STORE=db
LIDO_TEMPLATE_SYNC_SECONDS=10

# Local embedding model for template matching. lido_templates.embedding is vector(384),
# so a model with another dimension also needs that column altered.
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Paint over the parts of a generated background that a photo frame covers, so a
# subject the image model drew there can't show through. Leaves a flat patch that is
# visible when the photo layer is moved, so it's off by default.
LIDO_MASK_RESERVED_AREAS=false

# Vision model for scripts/enrich_lido_templates.py --draft-slots (reading a template's
# background/photo when onboarding templates into the catalog).
LIDO_ENRICH_VISION_MODEL=gpt-4o


# ======================================================================================
# 3. DESIGN FROM SCRATCH — a brand-new template from a prompt
#    (app/lido_create; images use IMAGE_MODEL / LIDO_TEMPLATE_IMAGE_QUALITY above)
# ======================================================================================

# -- Step 1: the art director's plan (empty model = LLM_MODEL_FAST) --------------------
LIDO_PLAN_MODEL=
LIDO_PLAN_REASONING_EFFORT=

# -- Step 2: the designer's layout (empty = LLM_MODEL with LLM_REASONING_EFFORT) -------
# *_REASONING_EFFORT: none | minimal | low | medium | high; empty = the defaults.
LIDO_LAYOUT_MODEL=
LIDO_LAYOUT_REASONING_EFFORT=
# First drafts requested at once per design; the first to pass the checks wins and saves
# a repair round. 2 cuts the wait when a draft would need repairs, but doubles layout cost.
LIDO_LAYOUT_CANDIDATES=1

# -- Step 3: repairs -------------------------------------------------------------------
# A design that fails its checks is first fixed by code (text fit, contrast, overlaps,
# photo placement…); what is left goes back as a small patch (only the elements that
# change) to the repair model — a fast non-reasoning one (gpt-4o) is enough.
# Empty = the layout model.
LIDO_REPAIR_MODEL=
LIDO_REPAIR_REASONING_EFFORT=

# -- Photos ----------------------------------------------------------------------------
# cache (placeholders from the existing corpus, free and instant) or generate (each
# photo rendered from its subject with IMAGE_MODEL at LIDO_TEMPLATE_IMAGE_QUALITY,
# uploaded to the asset store). generate needs OPENAI_API_KEY; a photo that fails to
# generate keeps a cached placeholder.
LIDO_DRAFT_PHOTOS=cache
# The most photos a new template may have (1-4). A brief that names more things to
# show gets this many, so at most this many images are generated per template.
# Restart the backend after changing it. Set 4 to bring multiple photos fully back
# (all layouts return); more than 4 needs code changes — see the PHOTO LIMIT guide in
# backend/app/lido_create/catalog.py.
LIDO_MAX_PHOTOS=4

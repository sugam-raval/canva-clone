# Copy to backend/.env and fill in. Only OPENAI_API_KEY is required for real output;
# without it every model adapter falls back to a deterministic stub and the pipeline
# still runs end to end.

OPENAI_API_KEY=

# Infrastructure — matches infra/docker-compose.yml
DATABASE_URL=postgresql+asyncpg://design:design@localhost:5442/design
REDIS_URL=redis://localhost:6380/0

STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9010
S3_BUCKET=design-assets
S3_ACCESS_KEY=designminio
S3_SECRET_KEY=designminio

# Models
LLM_MODEL=gpt-6-astra
LLM_REASONING_EFFORT=low
LLM_MODEL_FAST=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Local embedder (default). Dimension follows the model; 384 for MiniLM.
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
IMAGE_MODEL=gpt-image-2.5-sunburst

# Adapter selection: openai | stub (see app/adapters/registry.py)
ADAPTER_TEXT_TO_IMAGE=auto
ADAPTER_TRANSPARENT_IMAGE=auto
ADAPTER_INPAINTER=auto
ADAPTER_MATTING=auto
ADAPTER_GLYPH_DETECTOR=auto
# sentence-transformers | openai | hash
ADAPTER_EMBEDDER=sentence-transformers
ADAPTER_LLM=auto

# Cost ceilings (cents)
MAX_COST_CENTS_PER_REQUEST=200
MAX_COST_CENTS_PER_USER_PER_DAY=2000
